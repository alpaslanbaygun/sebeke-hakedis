<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Şebeke-M AutoCAD eklentisi.
    İki derleme çıkar:
      net46           → AutoCAD 2016–2024 (.NET Framework)
      net8.0-windows  → AutoCAD 2025 ve sonrası (.NET 8)
    AutoCAD başvuru dosyaları NuGet'ten gelir ve pakete konmaz (AutoCAD'in kendi dosyaları kullanılır).
  -->

  <PropertyGroup>
    <TargetFrameworks>net46;net8.0-windows</TargetFrameworks>
    <AssemblyName>SebekeHakedis</AssemblyName>
    <RootNamespace>SebekeHakedis.Eklenti</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Version>0.1.0</Version>
    <Product>Şebeke-M</Product>
    <Company>Şebeke-M</Company>
    <Description>Şebeke-M: elektrik dağıtım şebekesi proje, hakediş, durum tespit ve teknik hesap eklentisi</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS0618;NU1701;MSB3270</NoWarn>
    <DefineConstants>$(DefineConstants);AUTOCAD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Telefonla aynı malzeme kataloğu eklentiye gömülür -->
    <EmbeddedResource Include="..\..\..\ortak\katalog\kalemler.json" Link="Katalog\kalemler.json" LogicalName="SebekeHakedis.kalemler.json" />
    <!-- Lejant simge takımı (telefonun DXF çıktısıyla aynı bloklar) -->
    <EmbeddedResource Include="..\..\..\ortak\katalog\semboller.json" Link="Katalog\semboller.json" LogicalName="SebekeHakedis.semboller.json" />
    <!-- Ortak çizim stili (telefonun DXF'iyle aynı renk, çizgi tipi, yazı) -->
    <EmbeddedResource Include="..\..\..\ortak\katalog\cizim-stili.json" Link="Katalog\cizim-stili.json" LogicalName="SebekeHakedis.cizim-stili.json" />
    <!-- Menü kategorileri (şerit: kategori → hızlı çizim öğeleri) -->
    <EmbeddedResource Include="..\..\..\ortak\katalog\kategoriler.json" Link="Katalog\kategoriler.json" LogicalName="SebekeHakedis.kategoriler.json" />
    <!-- Şebeke-M markası: logo ve simgeler (üretici araclar/marka-uret.py) -->
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-logo.png" Link="Marka\logo.png" LogicalName="SebekeHakedis.marka.logo.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-16.png" Link="Marka\simge-16.png" LogicalName="SebekeHakedis.marka.simge-16.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-24.png" Link="Marka\simge-24.png" LogicalName="SebekeHakedis.marka.simge-24.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-32.png" Link="Marka\simge-32.png" LogicalName="SebekeHakedis.marka.simge-32.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-64.png" Link="Marka\simge-64.png" LogicalName="SebekeHakedis.marka.simge-64.png" />
    <!-- Hesap Merkezi sayfaları: derlemeden önce "node araclar/hesap-paketle.mjs" ile ortak/hesap/paket üretilir (CI yapar) -->
    <EmbeddedResource Include="..\..\..\ortak\hesap\paket\**\*" Link="Hesap\%(RecursiveDir)%(Filename)%(Extension)" LogicalName="SebekeHakedis.hesap.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net46'">
    <PackageReference Include="AutoCAD.NET" Version="20.1.0" ExcludeAssets="runtime" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <!-- Harita altlığı karoları (HttpClient) -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
