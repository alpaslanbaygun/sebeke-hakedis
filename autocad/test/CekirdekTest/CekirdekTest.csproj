<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SebekeHakedis.Test</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Çekirdek kaynakları doğrudan derlenir (eklentiyle aynı dosyalar) -->
    <Compile Include="..\..\src\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="ornek-dokum.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="telefon-proje.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="volt-telefon.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kalemler.json" Link="kalemler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\semboller.json" Link="semboller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kategoriler.json" Link="kategoriler.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
