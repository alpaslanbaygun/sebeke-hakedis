<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SebekeHakedis.Test</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Çekirdek kaynakları doğrudan derlenir (eklentiyle aynı dosyalar) -->
    <Compile Include="..\..\src\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="ornek-dokum.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="telefon-proje.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="volt-telefon.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kalemler.json" Link="kalemler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\semboller.json" Link="semboller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kategoriler.json" Link="kategoriler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\cizim-stili.json" Link="cizim-stili.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\malzeme-yazimi.json" Link="malzeme-yazimi.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kullanıcılar ve roller: telefonla ortak tablo ve ortak deneme (telefon/web/tests/kullanicilar.test.mjs de okur) -->
    <None Include="..\..\..\ortak\katalog\roller.json" Link="roller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\kullanicilar.json" Link="kullanicilar.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Telefonla ortak CBS denemesi: girdi ve beklenen KML / MIF / MID (telefon/web/tests/cbs.test.mjs de okur) -->
    <None Include="..\..\..\ortak\deneme\cbs\**\*" LinkBase="cbs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
