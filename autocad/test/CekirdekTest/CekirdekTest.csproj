<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SebekeHakedis.Test</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Çekirdek kaynakları doğrudan derlenir (eklentiyle aynı dosyalar) -->
    <Compile Include="..\..\src\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="ornek-dokum.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="telefon-proje.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="volt-telefon.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kalemler.json" Link="kalemler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\semboller.json" Link="semboller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\kategoriler.json" Link="kategoriler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\cizim-stili.json" Link="cizim-stili.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\malzeme-yazimi.json" Link="malzeme-yazimi.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Malzemelerin çizimde yazılması: telefonla ortak deneme (telefon/web/tests/malzeme-etiketi.test.mjs de okur) -->
    <None Include="..\..\..\ortak\deneme\malzeme-etiketi.json" Link="malzeme-etiketi.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kullanıcılar ve roller: telefonla ortak tablo ve ortak deneme (telefon/web/tests/kullanicilar.test.mjs de okur) -->
    <None Include="..\..\..\ortak\katalog\roller.json" Link="roller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\kullanicilar.json" Link="kullanicilar.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Kanal zemini ve kanal listesi: telefonla ortak deneme (telefon/web/tests/kanal.test.mjs de okur) -->
    <None Include="..\..\..\ortak\deneme\kanal-zemini.json" Link="kanal-zemini.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\kanal-listesi.json" Link="kanal-listesi.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Telefonla ortak CBS denemesi: girdi ve beklenen KML / MIF / MID (telefon/web/tests/cbs.test.mjs de okur) -->
    <None Include="..\..\..\ortak\deneme\cbs\**\*" LinkBase="cbs" CopyToOutputDirectory="PreserveNewest" />
    <!-- Telefonla ortak Birleşik Metraj denemesi: gömülü şablon, eşleşme tablosu, deneme projesi ve beklenen plan -->
    <None Include="..\..\..\ortak\deneme\birlesik-metraj\**\*" LinkBase="birlesik-metraj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\sablon\birlesik-metraj.xlsm" Link="birlesik-metraj.xlsm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\metraj-sablon.json" Link="metraj-sablon.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Telefonla ortak önerilen malzeme denemesi: kurallar, servis kodu eşlemesi, durumlar ve beklenen listeler -->
    <None Include="..\..\..\ortak\katalog\onerilen-malzeme.json" Link="onerilen-malzeme.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\katalog\volt-eslesme.json" Link="volt-eslesme.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\onerilen-malzeme\**\*" LinkBase="onerilen-malzeme" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\lisans\vektorler.json" Link="lisans\vektorler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\uzak-grup\vektorler.json" Link="uzak-grup\vektorler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\yazi-cakisma\vektorler.json" Link="yazi-cakisma\vektorler.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\lisans\acik-anahtar.json" Link="lisans\acik-anahtar.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
