<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Eklenti pencerelerinin AutoCAD olmadan denenmesi: her pencere örnek verilerle kurulur, ekran
    görüntüsü alınır (PNG) ve Tamam düğmesiyle dönen değerler denetlenir. Yalnız Windows'ta çalışır (CI).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SebekeHakedis.PencereTest</RootNamespace>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Eklenti\Pencereler.cs" Link="Eklenti\Pencereler.cs" />
    <Compile Include="..\..\src\Eklenti\OrtamVerisi.cs" Link="Eklenti\OrtamVerisi.cs" />
    <Compile Include="..\..\src\Eklenti\HizliSecim.cs" Link="Eklenti\HizliSecim.cs" />
    <Compile Include="..\..\src\Eklenti\SeritSimgeleri.cs" Link="Eklenti\SeritSimgeleri.cs" />
    <Compile Include="..\..\src\Eklenti\ArayuzSimgeleri.cs" Link="Eklenti\ArayuzSimgeleri.cs" />
    <Compile Include="..\..\src\Eklenti\KoyuTema.cs" Link="Eklenti\KoyuTema.cs" />
    <Compile Include="..\..\src\Eklenti\Marka.cs" Link="Eklenti\Marka.cs" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\kalemler.json" Link="Katalog\kalemler.json" LogicalName="SebekeHakedis.kalemler.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\cizim-stili.json" Link="Katalog\cizim-stili.json" LogicalName="SebekeHakedis.cizim-stili.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\semboller.json" Link="Katalog\semboller.json" LogicalName="SebekeHakedis.semboller.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\kategoriler.json" Link="Katalog\kategoriler.json" LogicalName="SebekeHakedis.kategoriler.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\onerilen-malzeme.json" Link="Katalog\onerilen-malzeme.json" LogicalName="SebekeHakedis.onerilen-malzeme.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\volt-eslesme.json" Link="Katalog\volt-eslesme.json" LogicalName="SebekeHakedis.volt-eslesme.json" />
    <!-- Roller ve yetkiler: telefonla ortak tablo -->
    <EmbeddedResource Include="..\..\..\ortak\katalog\roller.json" Link="Katalog\roller.json" LogicalName="SebekeHakedis.roller.json" />
    <!-- Şebeke-M markası: logo ve simgeler (üretici araclar/marka-uret.py) -->
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-logo.png" Link="Marka\logo.png" LogicalName="SebekeHakedis.marka.logo.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-16.png" Link="Marka\simge-16.png" LogicalName="SebekeHakedis.marka.simge-16.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-24.png" Link="Marka\simge-24.png" LogicalName="SebekeHakedis.marka.simge-24.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-32.png" Link="Marka\simge-32.png" LogicalName="SebekeHakedis.marka.simge-32.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\sebeke-m-simge-64.png" Link="Marka\simge-64.png" LogicalName="SebekeHakedis.marka.simge-64.png" />
    <EmbeddedResource Include="..\..\..\ortak\marka\hakkinda.json" Link="Marka\hakkinda.json" LogicalName="SebekeHakedis.marka.hakkinda.json" />
    <None Include="..\CekirdekTest\ornek-dokum.json" Link="ornek-dokum.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CekirdekTest\telefon-proje.sebeke.json" Link="telefon-proje.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\ortak\deneme\lisans\vektorler.json" Link="lisans-vektorler.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
