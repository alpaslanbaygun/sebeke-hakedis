<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Eklenti pencerelerinin AutoCAD olmadan denenmesi: her pencere örnek verilerle kurulur, ekran
    görüntüsü alınır (PNG) ve Tamam düğmesiyle dönen değerler denetlenir. Yalnız Windows'ta çalışır (CI).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>SebekeHakedis.PencereTest</RootNamespace>
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Cekirdek\**\*.cs" Link="Cekirdek\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Eklenti\Pencereler.cs" Link="Eklenti\Pencereler.cs" />
    <Compile Include="..\..\src\Eklenti\OrtamVerisi.cs" Link="Eklenti\OrtamVerisi.cs" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\kalemler.json" Link="Katalog\kalemler.json" LogicalName="SebekeHakedis.kalemler.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\cizim-stili.json" Link="Katalog\cizim-stili.json" LogicalName="SebekeHakedis.cizim-stili.json" />
    <EmbeddedResource Include="..\..\..\ortak\katalog\kategoriler.json" Link="Katalog\kategoriler.json" LogicalName="SebekeHakedis.kategoriler.json" />
    <None Include="..\CekirdekTest\ornek-dokum.json" Link="ornek-dokum.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CekirdekTest\telefon-proje.sebeke.json" Link="telefon-proje.sebeke.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
