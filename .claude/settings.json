{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"$CLAUDE_PROJECT_DIR/araclar/kod-haritasi/kanca.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
